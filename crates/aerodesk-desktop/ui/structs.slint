// AeroDesk 桌面 UI —— 视觉对齐 RustDesk 官方 Flutter 客户端（浅色 Material 主题）。
// 配色取自 rustdesk/flutter/lib/common.dart：
//   grayBg #EFEFF2 / accent #0071FF / 主区白底，正文 black87 #212121
// 2026-08 拆分：本文件仅聚合入口，组件见 structs/common/tray/app_window/windows/*。
export struct DeviceGroupEntry {
    is-header: bool,
    text: string,
    entry: string,
}
export struct ChatEntry {
    sender: string,
    text: string,
    own: bool,
}
// #503 文件传输中心条目（队列 + 活动 + 记录；progress < 0 隐藏进度条）。
export struct TransferEntry {
    id: string,
    name: string,
    direction: string, // 发送 / 接收
    size: string,      // 格式化大小文案
    progress: float,   // 0..1；排队中/终态为 -1
    state: string,     // 排队中/发送中/接收中/成功/失败/已取消
    detail: string,    // 失败原因等
    path: string,      // 本地路径（失败项重试用；空 = 不可重试）
}
