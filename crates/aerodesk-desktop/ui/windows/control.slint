// AeroDesk 桌面 UI —— 视觉对齐 RustDesk 官方 Flutter 客户端（浅色 Material 主题）。
// 配色取自 rustdesk/flutter/lib/common.dart：
//   grayBg #EFEFF2 / accent #0071FF / 主区白底，正文 black87 #212121
// 2026-08 拆分：本文件仅聚合入口，组件见 structs/common/tray/app_window/windows/*。
import { ProgressIndicator, ScrollView } from "std-widgets.slint";
import { IconBtn, RdButton } from "../common.slint";
export component ControlWindow inherits Window {
    in-out property <image> video-frame: @image-url("");
    in-out property <float> frame-w: 0;
    in-out property <float> frame-h: 0;
    in-out property <string> status: "连接中…";
    in-out property <string> input-mode: "键鼠已释放";
    in-out property <bool> input-capturing: false;
    // #503 隐私屏：开关状态 + 定制文字（开启后输入框可改，回车/按钮下发）。
    in-out property <bool> privacy-active: false;
    in-out property <string> privacy-text: "隐私屏已开启，请稍候…";
    // #503 电源命令确认框：非空 = 待确认动作（"关机"/"重启"/"锁屏"）。
    in-out property <string> power-confirm: "";

    callback send-input(int, int, float, float, float, float, float, float);
    callback send-key(int, string, bool, bool, bool, bool) -> bool;
    callback send-wheel(float, float, float, float, float, float, float, float);
    callback toggle-input();
    callback toggle-privacy();
    callback apply-privacy-text();
    callback disconnect();
    callback system-power(string);

    function cursor-pos(view-w: length, view-h: length, fw: float, fh: float, n: float, vertical: bool) -> length {
        let scale = min(view-w / max(fw * 1px, 1px), view-h / max(fh * 1px, 1px));
        let draw-w = fw * 1px * scale;
        let draw-h = fh * 1px * scale;
        if vertical { return (view-h - draw-h) / 2 + n * draw-h; }
        return (view-w - draw-w) / 2 + n * draw-w;
    }

    title: "AeroDesk 远程控制";
    width: 1000px;
    height: 680px;

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            background: #000000;
            vertical-stretch: 1;
            fs := FocusScope {
                focus-on-click: true;
                init => { fs.focus(); }
                key-pressed(event) => {
                    if root.send-key(0, event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) { accept } else { reject }
                }
                key-released(event) => {
                    if root.send-key(1, event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) { accept } else { reject }
                }
            }
            TouchArea {
                width: 100%;
                height: 100%;
                enabled: root.video-frame.width > 0;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down { fs.focus(); }
                    root.send-input(
                        event.kind == PointerEventKind.down ? 1 : (event.kind == PointerEventKind.up ? 2 : 0),
                        event.button == PointerEventButton.middle ? 1 : (event.button == PointerEventButton.right ? 2 : 0),
                        self.mouse-x / 1px,
                        self.mouse-y / 1px,
                        self.width / 1px,
                        self.height / 1px,
                        root.frame-w,
                        root.frame-h
                    );
                }
                scroll-event(event) => {
                    root.send-wheel(
                        self.mouse-x / 1px,
                        self.mouse-y / 1px,
                        self.width / 1px,
                        self.height / 1px,
                        root.frame-w,
                        root.frame-h,
                        event.delta-x / 1px,
                        event.delta-y / 1px
                    );
                    accept
                }
            }
            Image {
                source: root.video-frame;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }
            if root.video-frame.width == 0: Text {
                text: "等待媒体流…（对方上线/接通后自动播放）";
                color: #888888;
                font-size: 14px;
                vertical-alignment: center;
                horizontal-alignment: center;
                width: 100%;
                height: 100%;
            }
            Rectangle {
                x: 12px;
                y: 12px;
                width: 520px;
                height: 44px;
                border-radius: 6px;
                background: #ffffff;
                border-width: 1px;
                border-color: #d9d9de;
                HorizontalLayout {
                    cross-axis-alignment: center;
                    padding-left: 4px;
                    padding-right: 4px;
                    spacing: 2px;
                    IconBtn { icon: "\u{e312}"; active: root.input-capturing; tooltip: "输入"; clicked => { root.toggle-input(); } }
                    // #503 隐私屏：被控端黑屏 + 静音（control 通道下发）。
                    IconBtn { icon: "\u{e8f4}"; active: root.privacy-active; tooltip: "隐私屏（被控端黑屏+静音）"; clicked => { root.toggle-privacy(); } }
                    IconBtn { icon: "\u{e5cd}"; danger: true; tooltip: "断开"; clicked => { root.disconnect(); } }
                    Rectangle { width: 6px; }
                    // #503 电源命令（走白名单执行体系的内置安全命令，带确认）
                    IconBtn { icon: "\u{e8ac}"; danger: true; tooltip: "关机"; clicked => { root.power-confirm = "关机"; } }
                    IconBtn { icon: "\u{e863}"; tooltip: "重启"; clicked => { root.power-confirm = "重启"; } }
                    IconBtn { icon: "\u{e897}"; tooltip: "锁屏"; clicked => { root.power-confirm = "锁屏"; } }
                    Rectangle { width: 10px; }
                    Text {
                        text: root.status;
                        color: #34a853;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                }
            }
            // #503 电源命令确认框（覆盖在画面区居中；确认后经 system-power 下发）
            if root.power-confirm != "" : Rectangle {
                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: #66000000;
                    Rectangle {
                        x: (parent.width - 360px) / 2;
                        y: (parent.height - 160px) / 2;
                        width: 360px;
                        height: 160px;
                        border-radius: 12px;
                        background: #ffffff;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 12px;
                            Text {
                                text: "确认对被控端执行「" + root.power-confirm + "」？";
                                font-size: 15px;
                                font-weight: 600;
                                color: #212121;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.power-confirm == "关机"
                                    ? "关机后需人工重新开机才能恢复远控。"
                                    : (root.power-confirm == "重启"
                                        ? "重启后请等待被控端重新上线。"
                                        : "锁屏后需被控端解锁才能继续操作。");
                                font-size: 12px;
                                color: #7d7d84;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                                vertical-stretch: 1;
                            }
                            HorizontalLayout {
                                alignment: center;
                                spacing: 14px;
                                RdButton { text: "取消"; clicked => { root.power-confirm = ""; } }
                                RdButton { text: "确认执行"; primary: true; clicked => { root.system-power(root.power-confirm); root.power-confirm = ""; } }
                            }
                        }
                    }
                }
            }
        }
        // #503 隐私屏：开启时显示定制文字输入行（回车/按钮经 control 通道下发）。
        if root.privacy-active: Rectangle {
            height: 36px;
            background: #f5f5f7;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;
                cross-axis-alignment: center;
                Text {
                    text: "隐私屏文字：";
                    color: #7d7d84;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 320px;
                    height: 26px;
                    border-radius: 4px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: ti.has-focus ? #0071ff : #d9d9de;
                    ti := TextInput {
                        text <=> root.privacy-text;
                        x: 10px;
                        y: 0px;
                        width: parent.width - 20px;
                        height: 100%;
                        color: #212121;
                        font-size: 13px;
                        vertical-alignment: center;
                        single-line: true;
                        accepted => { root.apply-privacy-text(); }
                    }
                    // 手动 placeholder（TextInput 内建不支持 placeholder-text）
                    Text {
                        x: 10px;
                        y: 0px;
                        width: parent.width - 20px;
                        height: 100%;
                        text: "自定义被控端显示文字（回车更新）…";
                        color: #9a9aa0;
                        font-size: 13px;
                        vertical-alignment: center;
                        visible: root.privacy-text == "";
                    }
                }
                IconBtn { icon: "\u{e876}"; tooltip: "更新文字"; clicked => { root.apply-privacy-text(); } }
            }
        }
        Rectangle {
            height: 28px;
            background: #ffffff;
            HorizontalLayout {
                padding-left: 14px;
                spacing: 8px;
                Text {
                    text: "输入模式：" + root.input-mode;
                    color: #7d7d84;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }
        }
    }
}

