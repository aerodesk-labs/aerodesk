// AeroDesk 桌面 UI —— 视觉对齐 RustDesk 官方 Flutter 客户端（浅色 Material 主题）。
// 配色取自 rustdesk/flutter/lib/common.dart：
//   grayBg #EFEFF2 / accent #0071FF / 主区白底，正文 black87 #212121
// 2026-08 拆分：本文件仅聚合入口，组件见 structs/common/tray/app_window/windows/*。
// #503 传输中心：队列 + 逐项进度 + 传输记录（取消/重试）。
import { ProgressIndicator, ScrollView } from "std-widgets.slint";
import { RdButton } from "../common.slint";
import { TransferEntry } from "../structs.slint";
export component FileTransferWindow inherits Window {
    in-out property <[TransferEntry]> transfer-list: [];
    in-out property <string> status: "传输中心";

    callback add-files();
    callback cancel-item(string);
    callback retry-item(string);
    callback clear-done();

    title: "AeroDesk 传输中心";
    width: 720px;
    height: 520px;
    Rectangle {
        background: #f5f5f7;
        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 16px;
            padding-bottom: 16px;
            spacing: 12px;

            // 顶部状态 + 工具条
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.status;
                    color: #212121;
                    font-size: 14px;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }
                RdButton {
                    text: "添加文件";
                    primary: true;
                    clicked => { root.add-files(); }
                }
                RdButton {
                    text: "清空记录";
                    enabled: root.transfer-list.length > 0;
                    clicked => { root.clear-done(); }
                }
            }

            // 传输列表（队列 + 活动 + 记录）
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 8px;
                background: #ffffff;
                border-width: 1px;
                border-color: #dedee2;
                ScrollView {
                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        if root.transfer-list.length == 0: Text {
                            text: "暂无传输任务——拖拽文件到主窗口或点「添加文件」批量入队";
                            color: #9a9aa0;
                            font-size: 13px;
                            horizontal-alignment: center;
                        }
                        for entry in root.transfer-list: Rectangle {
                            height: 68px;
                            border-radius: 6px;
                            background: #fafafc;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 12px;
                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: entry.name;
                                        color: #212121;
                                        font-size: 14px;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: entry.direction;
                                            color: entry.direction == "接收" ? #2e7d32 : #0071ff;
                                            font-size: 12px;
                                        }
                                        Text {
                                            text: entry.size;
                                            color: #7d7d84;
                                            font-size: 12px;
                                        }
                                        Text {
                                            text: entry.state;
                                            color: entry.state == "失败" ? #e53935 : (entry.state == "成功" ? #2e7d32 : #7d7d84);
                                            font-size: 12px;
                                        }
                                        if entry.detail != "": Text {
                                            text: entry.detail;
                                            color: #9a9aa0;
                                            font-size: 12px;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    if entry.progress >= 0: ProgressIndicator {
                                        height: 4px;
                                        progress: entry.progress;
                                        horizontal-stretch: 1;
                                    }
                                }
                                RdButton {
                                    text: "取消";
                                    // 接收中无取消语义（核心无 cancel-receive 路径；接收行 id
                                    // 为 recv-active，cancel_send_id 永远匹配不到——#503 审查修复）。
                                    visible: entry.state == "发送中" || entry.state == "排队中";
                                    clicked => { root.cancel-item(entry.id); }
                                }
                                RdButton {
                                    text: "重试";
                                    visible: entry.state == "失败" && entry.path != "";
                                    clicked => { root.retry-item(entry.path); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
