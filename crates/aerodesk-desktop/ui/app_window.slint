// AeroDesk 桌面 UI —— 视觉对齐 RustDesk 官方 Flutter 客户端（浅色 Material 主题）。
// 配色取自 rustdesk/flutter/lib/common.dart：
//   grayBg #EFEFF2 / accent #0071FF / 主区白底，正文 black87 #212121
// 2026-08 拆分：本文件仅聚合入口，组件见 structs/common/tray/app_window/windows/*。
import { CheckBox, ProgressIndicator, ScrollView, Slider, Switch } from "std-widgets.slint";
import { DeviceGroupEntry, ChatEntry } from "structs.slint";
import { MIcon, RdButton, IconBtn, NavItem, PeerTab, IdentityRow, RdInput, PermissionCard } from "common.slint";

export component AppWindow inherits Window {
    // ---- 主页 ----
    in-out property <int> tab: 0;                 // 0=连接 1=设置 2=被控端
    in-out property <string> room-input: "demo";
    in-out property <string> token-input: "";
    in-out property <string> server-input: "signal.aerodesk.io";
    in-out property <string> status: "未连接";
    in-out property <string> log: "";
    in-out property <bool> connecting: false;
    in-out property <int> conn-state: 0;   // 0=idle 1=connecting 2=connected 3=failed
    in-out property <[string]> recents: [];
    in-out property <[string]> favorites: [];
    in-out property <[string]> addressbook: [];
    in-out property <[DeviceGroupEntry]> device-groups: [];
    in-out property <[string]> discovered: [];
    in-out property <string> ab-alias: "";
    in-out property <string> ab-group: "";
    in-out property <int> peer-tab: 0;   // 0=最近 1=收藏 2=发现 3=地址簿 4=设备组
    // 本机身份（被控端）
    in-out property <string> device-id: "—";
    in-out property <string> device-pw: "—";
    // ---- 会话 ----
    in-out property <bool> in-session: false;
    // #447 独立功能窗口：打开状态镜像（窗口关闭后恢复按钮）。
    in-out property <bool> control-open: false;
    in-out property <bool> view-open: false;
    in-out property <bool> camera-open: false;
    in-out property <bool> file-open: false;
    in-out property <bool> message-open: false;
    in-out property <bool> terminal-open: false;
    in-out property <image> video-frame: @image-url("");
    in-out property <[string]> session-tabs: [];
    in-out property <int> active-session: 0;
    in-out property <[image]> session-frames: [];
    in-out property <string> session-status: "";
    in-out property <string> input-mode: "键鼠已释放";
    // #73 观看端音量 0..1（默认 100%）。
    in-out property <float> volume: 1.0;
    // #72 文件传输进度（-1 隐藏，0..1 显示）。
    in-out property <float> file-progress: -1;
    in-out property <string> file-label: "";
    // #72 拖放发送：外部文件悬停高亮（Rust 侧拦截 winit DroppedFile 驱动）。
    in-out property <bool> file-drop-hover: false;
    // #75 远程光标（归一化 0..1；visible 控制显示）+ 视频源尺寸（letterbox 换算）。
    in-out property <float> remote-cursor-x: 0;
    in-out property <float> remote-cursor-y: 0;
    in-out property <bool> remote-cursor-visible: false;
    // #75 是否显示远端光标叠加层（设置-显示 可开）。
    // 默认关：对齐 RustDesk(show-remote-cursor=N)/TeamViewer(Show partner's cursor)
    // 主流默认，避免叠加箭头被误认为“光标被采集进视频”。
    in-out property <bool> show-remote-cursor: false;
    in-out property <float> frame-w: 0;
    in-out property <float> frame-h: 0;
    // ---- 设置 ----
    in-out property <int> settings-tab: 0;          // 0=显示 1=网络 2=安全 3=快捷键 4=AI 远控
    in-out property <int> translate-mode: 0;    // 0=直通 1=翻译到 Windows 2=翻译到 macOS（#496 G2）
    // #109 AI 远控：命令白名单 + 审计（本机管理入口）。
    in-out property <[string]> cmd-allowlist: [];
    in-out property <string> cmd-allowlist-input: "";
    in-out property <string> cmd-audit: "";
    in-out property <int> quality: 1;
    in-out property <string> server-default: "signal.aerodesk.io";
    // #504 信令 TLS 开关（默认关=ws://，自建明文服务器适用；开=wss://）。
    in-out property <bool> server-tls: false;
    // #504 presence 常驻连接是否存在（设置页「连接 / 登录」按钮文案切换用）。
    in-out property <bool> presence-active: false;
    in-out property <bool> remember-token: false;
    in-out property <string> token-default: "";
    in-out property <string> settings-status: "";
    // ---- 被控端授权 ----
    in-out property <string> perm-screen: "未知";
    in-out property <string> perm-a11y: "未知";
    // 被控端设置
    in-out property <bool> inc-enabled: false;
    in-out property <bool> inc-auto-accept: false;
    in-out property <bool> auto-start: false;   // #417 开机自启（Windows HKCU Run）
    in-out property <bool> inc-audio: true;
    in-out property <bool> inc-mouse: true;
    // #72 文件传输总开关：关闭后禁用发文件/剪贴板/拖放，并暂停接收落盘。
    in-out property <bool> file-transfer-enabled: true;
    // #58 当前会话静音态（工具栏音频按钮高亮用，按会话同步）。
    in-out property <bool> audio-muted: false;
    // 摄像头画面切换：camera-available=远端发布了摄像头轨；camera-active=当前显示摄像头。
    in-out property <bool> camera-available: false;
    in-out property <bool> camera-active: false;
    in-out property <bool> inc-view-only: false;
    // #444 信令连接状态（主界面常显）
    in-out property <string> signal-status: "信令未连接";
    in-out property <bool> signal-online: false;
    // 设置页密码编辑
    in-out property <string> pw-edit: "";

    callback connect();
    callback connect-view();
    callback connect-camera();
    // #447 独立功能窗口入口。
    callback open-file-window();
    callback open-message-window();
    callback open-terminal-window();
    callback disconnect();
    callback set-tab(int);
    callback connect-recent(string);
    callback copy-device-id();
    callback copy-device-pw();
    callback refresh-device-pw();
    callback toggle-fullscreen();
    callback toggle-audio();
    callback toggle-camera();
    // #73 观看端音量滑块（0..1）。
    callback change-volume(float);
    // #75：会话视图指针输入 → Rust 侧转发为 InputFrame（0=Move 1=Down 2=Up）。
    // 第二个 int 为按键（0=左 1=中 2=右，F4）：右键/中键也要转发被控端。
    // 传原始鼠标坐标 + 视频区尺寸 + 远端帧尺寸；Rust 侧按 image-fit: contain
    // 扣除 letterbox 后归一化，保证主控/被控宽高比不同时坐标不错位。
    callback send-input(int, int, float, float, float, float, float, float);
    // #75：键盘/滚轮输入 → Rust 侧转发为 InputFrame（send-key: 0=按下 1=抬起）。
    callback send-key(int, string, bool, bool, bool, bool) -> bool;
    // #75：滚轮 → send-wheel（原始坐标 + 尺寸 + 像素增量；Rust 侧 letterbox 扣减后归一化）。
    callback send-wheel(float, float, float, float, float, float, float, float);
    callback toggle-display();
    callback toggle-quality();
    callback toggle-input();
    // #72：会话视图文件/剪贴板按钮。
    callback toggle-file-transfer();
    callback send-file();
    callback send-clipboard();
    callback cancel-file();
    callback switch-session(int);
    callback set-settings-tab(int);
    // #109 AI 远控管理：白名单增删/刷新 + 审计刷新。
    callback cmd-allowlist-add();
    callback cmd-allowlist-remove(string);
    callback cmd-allowlist-refresh();
    callback cmd-audit-refresh();
    callback set-quality(int);
    callback set-translate-mode(int);
    // #504 信令 TLS 开关写回 + 「连接 / 登录」按钮（连接/断开 presence）。
    callback set-server-tls(bool);
    callback connect-signal();
    callback set-peer-tab(int);
    callback toggle-favorite(string);
    callback refresh-peers();
    callback add-addressbook();
    callback remove-addressbook(string);
    callback connect-addressbook(string);
    callback scan-lan();
    callback add-discovered(string);
    callback auto-save();
    callback toggle-inc();
    callback toggle-auto-start();   // #417 开机自启开关
    callback refresh-perms();
    callback open-screen-perms();
    callback open-a11y-perms();



    // #75：视频区 image-fit: contain 的 letterbox 换算：把归一化光标坐标
    // 映射到实际显示区域（扣除黑边）。
    function cursor-pos(view-w: length, view-h: length, fw: float, fh: float, n: float, vertical: bool) -> length {
        let scale = min(view-w / max(fw * 1px, 1px), view-h / max(fh * 1px, 1px));
        let draw-w = fw * 1px * scale;
        let draw-h = fh * 1px * scale;
        if vertical { return (view-h - draw-h) / 2 + n * draw-h; }
        return (view-w - draw-w) / 2 + n * draw-w;
    }

    title: "AeroDesk";
    width: 1000px;
    height: 680px;

    // ================ 左侧栏：本机身份（RustDesk buildLeftPane） ================
    HorizontalLayout {
        Rectangle {
            width: 200px;
            background: #efeff2;
            VerticalLayout {
                spacing: 2px;
                padding-top: 34px;
                // Logo：靠左对齐（左边距 12），下移避开左上角红绿灯（x 9-75, y 9-23）
                Rectangle {
                    height: 56px;
                    HorizontalLayout {
                        cross-axis-alignment: center;
                        padding-left: 12px;
                        spacing: 6px;
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 7px;
                            background: #0071ff;
                            Text {
                                text: "A";
                                color: #ffffff;
                                font-size: 15px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                        VerticalLayout {
                            Text { text: "AeroDesk"; font-size: 14px; font-weight: 700; color: #212121; }
                            Text { text: "Remote Desktop"; font-size: 11px; color: #8a8a90; }
                        }
                    }
                }

                // 「你的桌面」+ 提示（对齐 buildTip：左 20 / 右 16 / 上 16 / 下 5）
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 16px;
                    Text {
                        text: "你的桌面";
                        font-size: 19px;
                        color: #212121;
                        height: 26px;
                        vertical-stretch: 0;
                    }
                }
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 16px;
                    Text {
                        text: "使用下面的 ID 和密码，可以远程访问这台设备。";
                        font-size: 14px;
                        color: #6d6d73;
                        wrap: word-wrap;
                        height: 34px;
                        vertical-stretch: 0;
                    }
                }
                // #417 被控未开启提示：引导到被控端页面（tab=2 接入设置）开启开关。
                if !root.inc-enabled: HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 16px;
                    Text {
                        text: "当前设备还不接受被控，需要到被控端页面去开启「开启被控」开关。";
                        font-size: 13px;
                        color: #d97706;
                        wrap: word-wrap;
                        height: 34px;
                        vertical-stretch: 0;
                    }
                }
                Rectangle { height: 5px; }

                // ID 板（对齐 buildIDBoard：左 20 右 11，2px 蓝条 + ID 标签 + 22px 大号 ID）
                HorizontalLayout {
                    cross-axis-alignment: center;
                    padding-left: 20px;
                    padding-right: 8px;
                    IdentityRow {
                        label: "ID";
                        value: root.device-id;
                        value-size: 22px;
                        copy => { root.copy-device-id(); }
                    }
                    // 右上复制 ID（对齐 RustDesk buildPopupMenu 位置的复制入口）
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 13px;
                        background: mh.has-hover ? #ffffff : transparent;
                        MIcon { icon: "\u{e14d}"; size: 18px; color: #6d6d73; }   // content_copy
                        mh := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.copy-device-id(); }
                        }
                        Tooltip { text: @markdown("复制 ID"); }
                    }
                }
                // 密码板（对齐 buildPasswordBoard：左 20 右 16 上 13 下 13）
                HorizontalLayout {
                    cross-axis-alignment: center;
                    padding-left: 20px;
                    padding-right: 8px;
                    IdentityRow {
                        label: "一次性密码";
                        value: root.device-pw;
                        value-size: 15px;
                        copy => { root.copy-device-pw(); }
                    }
                    // 刷新/编辑（对齐 RustDesk buildPasswordBoard2 的 refresh/edit 图标）
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: rh.has-hover ? #ffffff : transparent;
                        MIcon { icon: "\u{e5d5}"; size: 18px; color: #6d6d73; }   // refresh
                        rh := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.refresh-device-pw(); }
                        }
                        Tooltip { text: @markdown("刷新一次性密码"); }
                    }
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: eh.has-hover ? #ffffff : transparent;
                        MIcon { icon: "\u{e3c9}"; size: 18px; color: #6d6d73; }   // edit
                        eh := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.set-tab(1); root.set-settings-tab(2); }
                        }
                        Tooltip { text: @markdown("修改密码"); }
                    }
                }

                // 底部导航（设置 / 被控端 入口，对齐 RustDesk 左下角齿轮）
                Rectangle { vertical-stretch: 1; min-height: 0px; }
                VerticalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    spacing: 2px;
                    NavItem { icon: "\u{e157}"; text: "连接"; selected: root.tab == 0; clicked => { root.set-tab(0); } }
                    NavItem { icon: "\u{e897}"; text: "被控端"; selected: root.tab == 2; clicked => { root.set-tab(2); } }
                    NavItem { icon: "\u{e8b8}"; text: "设置"; selected: root.tab == 1; clicked => { root.set-tab(1); } }
                }
                Rectangle { height: 10px; }
            }
        }

        // 左/右分隔线（RustDesk VerticalDivider）
        Rectangle {
            width: 1px;
            background: #dedee2;
        }

        // ================ 主区域（白底，RustDesk buildRightPane） ================
        Rectangle {
            background: #ffffff;
            // ---- 连接页 ----
            if !root.in-session && root.tab == 0: VerticalLayout {
                padding-left: 24px;
                padding-right: 28px;
                padding-top: 26px;
                spacing: 16px;

                // 「控制远程桌面」标题
                HorizontalLayout {
                    Text { text: "控制远程桌面"; font-size: 19px; color: #212121; height: 26px; vertical-stretch: 0; }
                    Rectangle { width: 6px; }
                    Rectangle {
                        width: 18px;
                        height: 26px;
                        MIcon { icon: "\u{e8fd}"; size: 16px; color: #9a9aa0; }   // help_outline
                    }
                }

                // #444 信令连接状态（明显常显）
                Rectangle {
                    height: 32px;
                    border-radius: 8px;
                    background: root.signal-online ? #e6f4ea : #fef7e0;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: root.signal-online ? #34a853 : #f9ab00;
                        }
                        Text {
                            text: "信令：" + root.signal-status;
                            color: root.signal-online ? #188038 : #b06000;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                    }
                }

                // 连接区：左 = 远端 ID 卡片，右 = 被控端授权（利用右侧空白）
                HorizontalLayout {
                    width: 100%;
                    cross-axis-alignment: stretch;
                    spacing: 16px;
                    // 远端 ID 卡片（对齐 RustDesk：白底、圆角 13、灰描边、右侧蓝色「连接」）
                    Rectangle {
                        width: 400px;
                        vertical-stretch: 0;
                        border-radius: 13px;
                        border-width: 1px;
                        border-color: #efeff2;
                        background: #ffffff;
                        VerticalLayout {
                            padding-left: 24px;
                            padding-right: 24px;
                            padding-top: 24px;
                            padding-bottom: 22px;
                            spacing: 14px;
                            Text { text: "远端 ID"; font-size: 14px; color: #7d7d84; height: 18px; vertical-stretch: 0; }
                            RdInput {
                                text <=> root.room-input;
                                placeholder: "输入对端 ID";
                                font-size: 22px;
                            }
                            VerticalLayout {
                                spacing: 8px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    RdButton {
                                        text: root.control-open ? "控制窗口已打开" : (connecting ? "连接中…" : "远程控制");
                                        enabled: !connecting && !root.control-open;
                                        primary: true;
                                        clicked => { root.connect(); }
                                    }
                                    RdButton {
                                        text: root.view-open ? "观看窗口已打开" : "观看";
                                        enabled: !connecting && !root.view-open;
                                        clicked => { root.connect-view(); }
                                    }
                                    RdButton {
                                        text: root.camera-open ? "摄像头窗口已打开" : "摄像头";
                                        enabled: !connecting && !root.camera-open;
                                        clicked => { root.connect-camera(); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    RdButton {
                                        text: "文件传输";
                                        enabled: !root.file-open;
                                        clicked => { root.open-file-window(); }
                                    }
                                    RdButton {
                                        text: "发消息";
                                        enabled: !root.message-open;
                                        clicked => { root.open-message-window(); }
                                    }
                                    RdButton {
                                        text: "终端";
                                        enabled: !root.terminal-open;
                                        clicked => { root.open-terminal-window(); }
                                    }
                                    RdButton {
                                        text: "断开";
                                        enabled: connecting || root.in-session || root.conn-state == 2;
                                        clicked => { root.disconnect(); }
                                    }
                                }
                                HorizontalLayout {
                                    Text {
                                        text: root.status;
                                        color: root.conn-state == 2 ? #34a853 : (root.conn-state == 3 ? #d93025 : #9a9aa0);
                                        font-size: 14px;
                                        vertical-alignment: center;
                                        vertical-stretch: 0;
                                    }
                                }
                            }
                        }
                    }

                    // 被控端授权卡片（与「被控端」页共用 PermissionCard 组件）
                    PermissionCard {
                        width: max(0px, parent.width - 416px);
                        perm-screen: root.perm-screen;
                        perm-a11y: root.perm-a11y;
                        refresh => { root.refresh-perms(); }
                        open-screen => { root.open-screen-perms(); }
                        open-a11y => { root.open-a11y-perms(); }
                    }
                }

                // 分隔线
                Rectangle { height: 1px; background: #efeff2; }

                // Peer 标签栏（对齐 RustDesk PeerTabPage：最近/收藏/发现/地址簿/设备组）
                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 4px;
                    height: 36px;
                    PeerTab { icon: "\u{e192}"; tooltip: "最近会话"; selected: root.peer-tab == 0; clicked => { root.set-peer-tab(0); } }
                    PeerTab { icon: "\u{e838}"; tooltip: "收藏"; selected: root.peer-tab == 1; clicked => { root.set-peer-tab(1); } }
                    PeerTab { icon: "\u{e87a}"; tooltip: "发现"; selected: root.peer-tab == 2; clicked => { root.set-peer-tab(2); } }
                    PeerTab { icon: "\u{e0ba}"; tooltip: "地址簿"; selected: root.peer-tab == 3; clicked => { root.set-peer-tab(3); } }
                    PeerTab { icon: "\u{e7ef}"; tooltip: "设备组"; selected: root.peer-tab == 4; clicked => { root.set-peer-tab(4); } }
                    Rectangle { width: 0px; horizontal-stretch: 1; }
                    IconBtn { icon: "\u{e5d5}"; tooltip: "刷新"; clicked => { root.refresh-peers(); } }
                }
                // 列表标题（跟随标签）
                Text {
                    text: root.peer-tab == 0 ? "最近会话" : (root.peer-tab == 1 ? "我的收藏" : (root.peer-tab == 2 ? "发现（局域网）" : (root.peer-tab == 3 ? "地址簿" : "设备组")));
                    font-size: 14px; color: #7d7d84; height: 18px; vertical-stretch: 0;
                }
                if root.peer-tab == 0: ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 2px;
                        for item in root.recents: Rectangle {
                            height: 46px;
                            border-radius: 8px;
                            background: rec.has-hover ? #f2f2f5 : transparent;
                            rec := TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                clicked => { root.connect-recent(item); }
                            }
                            HorizontalLayout {
                                cross-axis-alignment: center;
                                padding-left: 10px;
                                spacing: 12px;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 16px;
                                    background: #0071ff;
                                    Text {
                                        text: "A";
                                        color: #ffffff;
                                        font-size: 14px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }
                                }
                                Text {
                                    text: item;
                                    font-size: 14px;
                                    color: #212121;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Rectangle { width: 0px; horizontal-stretch: 1; }
                                IconBtn { icon: "\u{e83a}"; tooltip: "收藏"; clicked => { root.toggle-favorite(item); } }
                            }
                        }
                    }
                }
                if root.peer-tab == 1: ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 2px;
                        for item in root.favorites: Rectangle {
                            height: 46px;
                            border-radius: 8px;
                            background: fav.has-hover ? #f2f2f5 : transparent;
                            fav := TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                clicked => { root.connect-recent(item); }
                            }
                            HorizontalLayout {
                                cross-axis-alignment: center;
                                padding-left: 10px;
                                spacing: 12px;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 16px;
                                    background: #f5a623;
                                    Text {
                                        text: "★";
                                        color: #ffffff;
                                        font-size: 14px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }
                                }
                                Text {
                                    text: item;
                                    font-size: 14px;
                                    color: #212121;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Rectangle { width: 0px; horizontal-stretch: 1; }
                                IconBtn { icon: "\u{e838}"; tooltip: "取消收藏"; clicked => { root.toggle-favorite(item); } }
                            }
                        }
                    }
                }
                // ---- 发现（局域网扫描）----
                if root.peer-tab == 2: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        cross-axis-alignment: center;
                        spacing: 10px;
                        RdButton { text: "扫描局域网"; primary: true; width: 110px; clicked => { root.scan-lan(); } }
                        Text { text: "扫描本网段信令端口（3003）"; font-size: 13px; color: #7d7d84; height: 18px; vertical-stretch: 0; }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            for item in root.discovered: Rectangle {
                                height: 42px;
                                border-radius: 8px;
                                background: dsc.has-hover ? #f2f2f5 : transparent;
                                dsc := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: pointer;
                                    clicked => { root.connect-addressbook(item); }
                                }
                                HorizontalLayout {
                                    cross-axis-alignment: center;
                                    padding-left: 10px;
                                    spacing: 10px;
                                    Rectangle { width: 26px; height: 26px; border-radius: 13px; background: #34a853; Text { text: "·"; color: #fff; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; } }
                                    Text { text: item; font-size: 13px; color: #212121; vertical-alignment: center; overflow: elide; }
                                    Rectangle { width: 0px; horizontal-stretch: 1; }
                                    IconBtn { icon: "\u{e865}"; tooltip: "添加到地址簿"; clicked => { root.add-discovered(item); } }
                                }
                            }
                        }
                    }
                }
                // ---- 地址簿（本地持久化）----
                if root.peer-tab == 3: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        cross-axis-alignment: center;
                        spacing: 8px;
                        Text { text: "别名"; font-size: 13px; color: #7d7d84; height: 18px; vertical-stretch: 0; }
                        Rectangle { width: 110px; height: 34px; border-radius: 8px; background: #efeff2; ti := TextInput { x: 10px; y: 0px; width: parent.width - 20px; height: 100%; text <=> root.ab-alias; color: #212121; font-size: 13px; vertical-alignment: center; single-line: true; } }
                        Text { text: "分组"; font-size: 13px; color: #7d7d84; height: 18px; vertical-stretch: 0; }
                        Rectangle { width: 90px; height: 34px; border-radius: 8px; background: #efeff2; tg := TextInput { x: 10px; y: 0px; width: parent.width - 20px; height: 100%; text <=> root.ab-group; color: #212121; font-size: 13px; vertical-alignment: center; single-line: true; } }
                        RdButton { text: "添加"; width: 64px; clicked => { root.add-addressbook(); } }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            for item in root.addressbook: Rectangle {
                                height: 46px;
                                border-radius: 8px;
                                background: ab.has-hover ? #f2f2f5 : transparent;
                                ab := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: pointer;
                                    clicked => { root.connect-addressbook(item); }
                                }
                                HorizontalLayout {
                                    cross-axis-alignment: center;
                                    padding-left: 10px;
                                    spacing: 12px;
                                    Rectangle { width: 32px; height: 32px; border-radius: 16px; background: #e0742e; Text { text: "✉"; color: #fff; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; } }
                                    Text { text: item; font-size: 13px; color: #212121; vertical-alignment: center; overflow: elide; }
                                    Rectangle { width: 0px; horizontal-stretch: 1; }
                                    IconBtn { icon: "\u{e872}"; danger: true; tooltip: "删除"; clicked => { root.remove-addressbook(item); } }
                                }
                            }
                        }
                    }
                }
                // ---- 设备组（按地址簿“分组”字段聚合展示：组标题 + 组内设备）----
                if root.peer-tab == 4: ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 2px;
                        for item in root.device-groups: Rectangle {
                            visible: item.is-header;
                            height: 30px;
                            padding-left: 10px;
                            Text { text: item.text; font-size: 13px; font-weight: 600; color: #7d7d84; vertical-alignment: center; }
                        }
                        for item in root.device-groups: Rectangle {
                            visible: !item.is-header;
                            height: 42px;
                            border-radius: 8px;
                            background: dgrp.has-hover ? #f2f2f5 : transparent;
                            dgrp := TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                clicked => { root.connect-addressbook(item.entry); }
                            }
                            HorizontalLayout {
                                cross-axis-alignment: center;
                                padding-left: 10px;
                                spacing: 10px;
                                Rectangle { width: 30px; height: 30px; border-radius: 15px; background: #6d3bdc; Text { text: "☰"; color: #fff; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; } }
                                Text { text: item.text; font-size: 13px; color: #212121; vertical-alignment: center; overflow: elide; }
                                Rectangle { width: 0px; horizontal-stretch: 1; }
                                IconBtn { icon: "\u{e872}"; danger: true; tooltip: "删除"; clicked => { root.remove-addressbook(item.entry); } }
                            }
                        }
                    }
                }

                // 底部状态栏（对齐 RustDesk OnlineStatusWidget）
                HorizontalLayout {
                    padding-top: 6px;
                    padding-bottom: 8px;
                    spacing: 8px;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.conn-state == 2 ? #34a853 : (root.conn-state == 3 ? #e04f5f : (root.connecting ? #f5a623 : #efeff2));
                    }
                    Text {
                        text: root.status == "" ? "就绪" : root.status;
                        font-size: 14px;
                        color: #616161;
                        vertical-alignment: center;
                        vertical-stretch: 0;
                    }
                    Rectangle { width: 0px; }
                    if root.log != "": Text {
                        text: root.log;
                        font-size: 12px;
                        color: #9a9aa0;
                        vertical-alignment: center;
                        overflow: elide;
                        vertical-stretch: 0;
                    }
                }
            }

            // ---- 设置页 ----
            if !root.in-session && root.tab == 1: VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 24px;
                spacing: 16px;
                Text { text: "设置"; font-size: 19px; color: #212121; height: 26px; vertical-stretch: 0; }
                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 8px;
                    RdButton { text: "显示"; width: 72px; checked: root.settings-tab == 0; clicked => { root.set-settings-tab(0); } }
                    RdButton { text: "网络"; width: 72px; checked: root.settings-tab == 1; clicked => { root.set-settings-tab(1); } }
                    RdButton { text: "安全"; width: 72px; checked: root.settings-tab == 2; clicked => { root.set-settings-tab(2); } }
                    RdButton { text: "快捷键"; width: 84px; checked: root.settings-tab == 3; clicked => { root.set-settings-tab(3); } }
                    RdButton { text: "AI 远控"; width: 84px; checked: root.settings-tab == 4; clicked => { root.set-settings-tab(4); } }
                }
                Rectangle { height: 1px; background: #efeff2; }

                if root.settings-tab == 0: VerticalLayout {
                    spacing: 12px;
                    Text { text: "显示质量"; font-size: 15px; color: #212121; height: 20px; vertical-stretch: 0; }
                    HorizontalLayout {
                        cross-axis-alignment: center;
                        spacing: 8px;
                        RdButton { text: "清晰（8Mbps）"; width: 120px; checked: root.quality == 0; clicked => { root.set-quality(0); root.auto-save(); } }
                        RdButton { text: "平衡（4Mbps）"; width: 120px; checked: root.quality == 1; clicked => { root.set-quality(1); root.auto-save(); } }
                        RdButton { text: "流畅（1.5Mbps）"; width: 120px; checked: root.quality == 2; clicked => { root.set-quality(2); root.auto-save(); } }
                    }
                    Text { text: "质量 → 目标码率：清晰 8Mbps / 平衡 4Mbps / 流畅 1.5Mbps（对接 SFU 选层）"; font-size: 14px; color: #7d7d84; height: 18px; vertical-stretch: 0; }
                    Switch { text: "显示远端光标（蓝色叠加层，表示被控端鼠标位置）"; checked <=> root.show-remote-cursor; toggled => { root.auto-save(); } }
                }
                if root.settings-tab == 1: VerticalLayout {
                    spacing: 12px;
                    Text { text: "默认信令服务器"; font-size: 15px; color: #212121; height: 20px; vertical-stretch: 0; }
                    RdInput { text <=> root.server-default; placeholder: "signal.aerodesk.io 或 127.0.0.1:3003"; font-size: 14px; edited => { root.server-input = root.server-default; root.auto-save(); } }
                    // #504 显式 TLS 选择：默认关（ws://）；自建明文服务器填裸地址即可直连，
                    // 不再被「非回环默认 wss」的启发式卡在 TLS 握手。
                    Switch { text: "使用 TLS 加密（wss://）——自建明文服务器请保持关闭（默认）"; checked <=> root.server-tls; toggled => { root.set-server-tls(root.server-tls); root.auto-save(); } }
                    HorizontalLayout {
                        cross-axis-alignment: center;
                        spacing: 10px;
                        RdButton { text: root.presence-active ? "断开" : "连接 / 登录"; width: 120px; clicked => { root.connect-signal(); } }
                        Text { text: root.signal-status; font-size: 13px; color: root.signal-online ? #188038 : #7d7d84; vertical-alignment: center; }
                    }
                    Text { text: "中继偏好：自动（直连失败走 TURN）"; font-size: 14px; color: #7d7d84; height: 18px; vertical-stretch: 0; }
                }
                if root.settings-tab == 2: VerticalLayout {
                    spacing: 12px;
                    CheckBox { text: "记住访问凭证 / JWT"; checked <=> root.remember-token; toggled => { root.auto-save(); } }
                    Text { text: "默认访问凭证 / JWT（可选）"; font-size: 15px; color: #212121; height: 20px; vertical-stretch: 0; }
                    RdInput { text <=> root.token-default; placeholder: "默认访问凭证 / JWT（可选）"; font-size: 14px; edited => { root.auto-save(); } }
                    Rectangle { height: 1px; background: #efeff2; }
                    Text { text: "本机接入密码（被控端一次性密码）"; font-size: 15px; color: #212121; height: 20px; vertical-stretch: 0; }
                    RdInput { text <=> root.pw-edit; placeholder: "留空则不修改"; font-size: 14px; edited => { root.auto-save(); } }
                    Text { text: "修改后立即生效并同步左栏；点左栏刷新图标可随机生成"; font-size: 13px; color: #7d7d84; height: 18px; vertical-stretch: 0; }
                }
                if root.settings-tab == 3: VerticalLayout {
                    spacing: 12px;
                    Text { text: "跨端修饰键翻译"; font-size: 15px; font-weight: 600; color: #212121; height: 20px; vertical-stretch: 0; }
                    Text { text: "直通（默认）：Cmd=Win 键 / Ctrl=Ctrl，物理保真。翻译到 Windows：mac 主控 Cmd+C 等同远端 Ctrl+C（复制/粘贴可用）。翻译到 macOS：Win 主控 Ctrl+C 等同远端 Cmd+C。"; font-size: 13px; color: #7d7d84; height: 44px; vertical-stretch: 0; wrap: word-wrap; }
                    HorizontalLayout {
                        cross-axis-alignment: center;
                        spacing: 8px;
                        RdButton { text: "直通（物理保真）"; width: 140px; checked: root.translate-mode == 0; clicked => { root.set-translate-mode(0); root.auto-save(); } }
                        RdButton { text: "翻译到 Windows"; width: 140px; checked: root.translate-mode == 1; clicked => { root.set-translate-mode(1); root.auto-save(); } }
                        RdButton { text: "翻译到 macOS"; width: 130px; checked: root.translate-mode == 2; clicked => { root.set-translate-mode(2); root.auto-save(); } }
                    }
                    Text { text: "快捷键"; font-size: 15px; font-weight: 600; color: #212121; height: 20px; vertical-stretch: 0; }
                    Text { text: "全屏：F11（待绑定）"; font-size: 14px; color: #4d4d52; height: 18px; vertical-stretch: 0; }
                    Text { text: "输入捕获/释放：Esc（待绑定）"; font-size: 14px; color: #4d4d52; height: 18px; vertical-stretch: 0; }
                    Text { text: "断开：Ctrl+Alt+D（待绑定）"; font-size: 14px; color: #4d4d52; height: 18px; vertical-stretch: 0; }
                }
                if root.settings-tab == 4: VerticalLayout {
                    spacing: 10px;
                    Text { text: "AI 远控权限（#109）"; font-size: 15px; font-weight: 600; color: #212121; height: 20px; vertical-stretch: 0; }
                    Text { text: "命令白名单：每行一个前缀；危险命令（rm -rf/dd/shutdown/交互式等）默认拦截，前缀命中可放行。文件在 ~/AeroDesk/cmd-allowlist.txt。"; font-size: 13px; color: #7d7d84; height: 32px; vertical-stretch: 0; }
                    HorizontalLayout {
                        cross-axis-alignment: center;
                        spacing: 8px;
                        RdInput { text <=> root.cmd-allowlist-input; placeholder: "命令前缀，如 /tmp/safe"; font-size: 14px; accepted => { root.cmd-allowlist-add(); } }
                        RdButton { text: "添加"; width: 72px; clicked => { root.cmd-allowlist-add(); } }
                        RdButton { text: "刷新"; width: 72px; clicked => { root.cmd-allowlist-refresh(); } }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            if root.cmd-allowlist.length == 0: Text { text: "（空）"; font-size: 13px; color: #9a9aa0; height: 24px; }
                            for item in root.cmd-allowlist: Rectangle {
                                height: 34px;
                                border-radius: 6px;
                                background: #f7f7f9;
                                HorizontalLayout {
                                    cross-axis-alignment: center;
                                    padding-left: 10px;
                                    spacing: 8px;
                                    Text { text: item; font-size: 13px; color: #212121; vertical-alignment: center; overflow: elide; }
                                    Rectangle { width: 0px; horizontal-stretch: 1; }
                                    IconBtn { icon: "\u{e872}"; danger: true; tooltip: "移除"; clicked => { root.cmd-allowlist-remove(item); } }
                                }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: #efeff2; }
                    Text { text: "命令审计（最近 30 条，~/AeroDesk/cmd-audit.jsonl）"; font-size: 14px; color: #4d4d52; height: 18px; vertical-stretch: 0; }
                    HorizontalLayout {
                        RdButton { text: "刷新审计"; width: 96px; clicked => { root.cmd-audit-refresh(); } }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        Text { text: root.cmd-audit; font-size: 11px; color: #4d4d52; }
                    }
                }
                Text { text: "所有设置修改后自动保存"; font-size: 13px; color: #9a9aa0; height: 18px; vertical-stretch: 0; }
            }

            // ---- 被控端页 ----
            if !root.in-session && root.tab == 2: VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 24px;
                spacing: 16px;
                Text { text: "被控端"; font-size: 19px; color: #212121; height: 26px; vertical-stretch: 0; }
                Text { text: "本机作为被控端时的接入设置与 macOS 权限："; font-size: 14px; color: #6d6d73; height: 18px; vertical-stretch: 0; }

                // 被控端设置卡片
                Rectangle {
                    width: 420px;
                    vertical-stretch: 0;
                    border-radius: 13px;
                    border-width: 1px;
                    border-color: #efeff2;
                    background: #ffffff;
                    VerticalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        padding-top: 18px;
                        padding-bottom: 18px;
                        spacing: 10px;
                        Text { text: "接入设置"; font-size: 15px; font-weight: 600; color: #212121; height: 20px; vertical-stretch: 0; }
                        Switch { text: "开启被控（允许被远程接入）"; checked <=> root.inc-enabled; toggled => { root.auto-save(); root.toggle-inc(); } }
                        Switch { text: "免授权（已授权设备呼叫直接接听，不弹确认框）"; enabled: root.inc-enabled; checked <=> root.inc-auto-accept; toggled => { root.auto-save(); } }
                        Switch { text: "开机自启（登录后自动接受被控）"; checked <=> root.auto-start; toggled => { root.toggle-auto-start(); } }
                        Switch { text: "允许声音（被控端采集系统音频）"; enabled: root.inc-enabled; checked <=> root.inc-audio; toggled => { root.auto-save(); } }
                        Switch { text: "仅观看（只读，禁止鼠标/键盘控制）"; enabled: root.inc-enabled; checked <=> root.inc-view-only; toggled => { root.auto-save(); } }
                        Text { text: "设置修改后自动保存；开关即时反映状态"; font-size: 13px; color: #7d7d84; height: 18px; vertical-stretch: 0; }
                    }
                }

                // 权限卡片（与主页共用 PermissionCard 组件，视觉一致）
                Rectangle {
                    width: 420px;
                    vertical-stretch: 0;
                    PermissionCard {
                        perm-screen: root.perm-screen;
                        perm-a11y: root.perm-a11y;
                        refresh => { root.refresh-perms(); }
                        open-screen => { root.open-screen-perms(); }
                        open-a11y => { root.open-a11y-perms(); }
                    }
                }
            }

        }
    }
}


