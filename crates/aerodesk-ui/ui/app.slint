// AeroDesk 桌面 UI —— 视觉对齐 RustDesk 官方 Flutter 客户端（浅色 Material 主题）。
// 配色取自 rustdesk/flutter/lib/common.dart：
//   grayBg #EFEFF2（左栏 / 输入框填充 / 卡片描边）
//   accent #0071FF（左栏蓝色竖条 / 主按钮）
//   主区白底，正文 black87 #212121，次要文字 50% 透明度
import { CheckBox, ProgressIndicator, ScrollView, Slider, Switch } from "std-widgets.slint";
import "fonts/MaterialIcons-Regular.ttf";

// Material 图标（对齐 RustDesk 的 Material Icons 工具栏/标签栏/导航）。
// Material Icons 字形在 em 框内视觉偏上，默认给 2px 下移让图标视觉居中。
component MIcon {
    in property <string> icon;
    in property <length> size: 20px;
    in property <brush> color: #4d4d52;
    in property <length> y-offset: 2px;
    width: 100%;
    height: 100%;
    Text {
        text: root.icon;
        font-family: "Material Icons";
        font-size: root.size;
        color: root.color;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
        y: root.y-offset;
    }
}

// 设备组（按地址簿“分组”字段聚合展示）：is-header 行为组标题，否则为设备行。
export struct DeviceGroupEntry {
    is-header: bool,
    text: string,
    entry: string,
}

// ---------- 通用控件 ----------

// RustDesk 风格按钮：主按钮蓝底白字 / 次按钮浅灰底，圆角 8。
component RdButton {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <bool> checked: false;
    callback clicked;
    height: 30px;
    min-width: 64px;
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        background: root.enabled
            ? (root.primary
                ? (ta.has-hover ? #0063d9 : #0071ff)
                : (ta.has-hover ? #e4e4e8 : #efeff2))
            : #f5f5f7;
        border-width: root.primary ? 0px : 1px;
        border-color: root.checked ? #0071ff : #dedee2;
        ta := TouchArea {
            width: 100%;
            height: 100%;
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
        Text {
            width: 100%;
            height: 100%;
            text: root.text;
            color: root.primary ? #ffffff : (root.checked ? #0071ff : #212121);
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// 圆角小图标按钮（会话工具栏 / 左栏导航）。
component IconBtn {
    in property <string> icon;
    in property <string> tooltip: "";
    in property <bool> active: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked;
    width: 36px;
    height: 32px;
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 6px;
        background: root.enabled && ta.has-hover ? (root.danger ? #ffecec : #e8e8ec) : transparent;
        border-width: 1px;
        border-color: root.active ? #0071ff : transparent;
        ta := TouchArea {
            width: 100%;
            height: 100%;
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
        MIcon {
            icon: root.icon;
            size: 18px;
            color: root.enabled ? (root.danger ? #d93025 : (root.active ? #0071ff : #5f6368)) : #bdbdc4;
        }
        if root.tooltip != "": Tooltip {
            Rectangle {
                background: #3c4043;
                border-radius: 4px;
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 4px;
                Text { text: root.tooltip; font-size: 12px; color: #ffffff; }
            }
        }
    }
}

// 左栏导航项：图标 + 文字，选中时蓝字 + 浅蓝底。
component NavItem {
    in property <string> icon;
    in property <string> text;
    in property <bool> selected: false;
    callback clicked;
    width: 100%;
    height: 36px;
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 6px;
        background: root.selected ? #e3ecfb : (ta.has-hover ? #e4e4e8 : transparent);
        HorizontalLayout {
            cross-axis-alignment: center;
            padding-left: 12px;
            spacing: 10px;
            Rectangle {
                width: 22px;
                height: 22px;
                MIcon {
                    icon: root.icon;
                    size: 18px;
                    color: root.selected ? #0071ff : #6d6d73;
                }
            }
            Text {
                text: root.text;
                font-size: 14px;
                color: root.selected ? #0071ff : #3c3c40;
                vertical-alignment: center;
            }
        }
        ta := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
        Tooltip {
            Rectangle {
                background: #3c4043;
                border-radius: 4px;
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 4px;
                Text { text: root.text; font-size: 12px; color: #ffffff; }
            }
        }
    }
}

// Peer 标签（对齐 RustDesk PeerTabPage：图标 + 选中 2px 底边）。
component PeerTab {
    in property <string> icon;
    in property <string> tooltip: "";
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked;
    width: 44px;
    height: 32px;
    Rectangle {
        width: 100%;
        height: 100%;
        background: root.enabled && root.selected ? transparent : (ta.has-hover && root.enabled ? #eef0f4 : transparent);
        Rectangle {
            width: 100%;
            height: 2px;
            y: parent.height - 2px;
            background: root.enabled && root.selected ? #0071ff : transparent;
        }
        MIcon {
            icon: root.icon;
            size: 21px;
            color: !root.enabled ? #c4c4ca : (root.selected ? #0071ff : #8a8a90);
        }
        ta := TouchArea {
            width: 100%;
            height: 100%;
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
        if root.enabled && root.tooltip != "": Tooltip {
            Rectangle {
                background: #3c4043;
                border-radius: 4px;
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 4px;
                Text { text: root.tooltip; font-size: 12px; color: #ffffff; }
            }
        }
    }
}

// 左栏本机身份行（ID / 密码）：2px 蓝色竖条 + 标签 + 大号值（对齐 RustDesk buildIDBoard）。
component IdentityRow {
    in property <string> label;
    in property <string> value;
    in property <length> value-size: 22px;
    callback copy;
    height: 62px;
    HorizontalLayout {
        Rectangle {
            width: 2px;
            height: 100%;
            background: #0071ff;
        }
        VerticalLayout {
            padding-left: 7px;
            spacing: 2px;
            Text {
                text: root.label;
                font-size: 14px;
                color: #7d7d84;
            }
            Text {
                text: root.value;
                font-size: root.value-size;
                color: #212121;
            }
        }
    }
}

// 输入框：灰底 #EFEFF2、圆角 8、左内边距 15（对齐 RustDesk inputDecorationTheme）。
component RdInput {
    in property <string> placeholder: "";
    in property <length> font-size: 16px;
    in-out property <string> text: "";
    callback edited;
    height: 48px;
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        background: #efeff2;
        border-width: 1px;
        border-color: ti.has-focus ? #0071ff : transparent;
        ti := TextInput {
            x: 15px;
            y: 0px;
            width: parent.width - 30px;
            height: 100%;
            text <=> root.text;
            color: #212121;
            font-size: root.font-size;
            vertical-alignment: center;
            single-line: true;
            edited => { root.edited(); }
        }
        // 手动 placeholder（TextInput 内建不支持 placeholder-text）
        Text {
            x: 15px;
            y: 0px;
            width: parent.width - 30px;
            height: 100%;
            text: root.placeholder;
            color: #9a9aa0;
            font-size: root.font-size;
            vertical-alignment: center;
            visible: root.text == "";
        }
    }
}

// 会话标签页（多会话）。
component SessionTab {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked;
    height: 28px;
    min-width: 90px;
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 6px;
        background: root.selected ? #ffffff : #ececf0;
        border-width: 1px;
        border-color: #dedee2;
        Text {
            width: 100%;
            height: 100%;
            text: root.text;
            font-size: 14px;
            color: root.selected ? #0071ff : #4d4d52;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        ta := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
}

// 被控端授权卡片（主页右侧 + 被控端页共用，保证视觉一致）。
component PermissionCard {
    in property <string> perm-screen;
    in property <string> perm-a11y;
    callback refresh;
    callback open-screen;
    callback open-a11y;
    Rectangle {
        vertical-stretch: 0;
        width: 100%;
        border-radius: 13px;
        border-width: 1px;
        border-color: #efeff2;
        background: #ffffff;
        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 24px;
            padding-bottom: 22px;
            spacing: 14px;
            Text { text: "被控端授权"; font-size: 19px; color: #212121; height: 26px; vertical-stretch: 0; }
            Text {
                text: "被控端需要以下 macOS 权限（其他平台后续接入）：";
                font-size: 14px; color: #6d6d73; height: 20px; vertical-stretch: 0;
            }
            HorizontalLayout {
                alignment: space-between;
                cross-axis-alignment: center;
                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 10px;
                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.perm-screen == "已授权" ? #34a853 : #efeff2; }
                    Text { text: "屏幕录制："; width: 90px; font-size: 14px; color: #212121; vertical-alignment: center; vertical-stretch: 0; }
                    Text { text: root.perm-screen; font-size: 14px; color: root.perm-screen == "已授权" ? #34a853 : #d93025; vertical-alignment: center; vertical-stretch: 0; }
                }
                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 4px;
                    IconBtn { icon: "\u{e5d5}"; tooltip: "检查权限"; clicked => { root.refresh(); } }
                    IconBtn { icon: "\u{e8b8}"; tooltip: "打开屏幕录制设置"; clicked => { root.open-screen(); } }
                }
            }
            HorizontalLayout {
                alignment: space-between;
                cross-axis-alignment: center;
                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 10px;
                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.perm-a11y == "已授权" ? #34a853 : #efeff2; }
                    Text { text: "辅助功能："; width: 90px; font-size: 14px; color: #212121; vertical-alignment: center; vertical-stretch: 0; }
                    Text { text: root.perm-a11y; font-size: 14px; color: root.perm-a11y == "已授权" ? #34a853 : #d93025; vertical-alignment: center; vertical-stretch: 0; }
                }
                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 4px;
                    IconBtn { icon: "\u{e5d5}"; tooltip: "检查权限"; clicked => { root.refresh(); } }
                    IconBtn { icon: "\u{e8b8}"; tooltip: "打开辅助功能设置"; clicked => { root.open-a11y(); } }
                }
            }
            Text { text: "授权后重启应用生效（屏幕录制）"; font-size: 13px; color: #7d7d84; height: 18px; vertical-stretch: 0; }
        }
    }
}

// 系统托盘（Slint 1.17 SystemTrayIcon：图标 + 菜单）。
export component Tray inherits SystemTrayIcon {
    icon: @image-url("tray-icon.png");
    tooltip: "AeroDesk 远程桌面";
    callback show-window();
    callback quit-app();
    Menu {
        MenuItem { title: "显示主窗口"; activated => { root.show-window(); } }
        MenuSeparator { }
        MenuItem { title: "退出 AeroDesk"; activated => { root.quit-app(); } }
    }
}

// ---------- 主窗口 ----------
export component AppWindow inherits Window {
    // ---- 主页 ----
    in-out property <int> tab: 0;                 // 0=连接 1=设置 2=被控端
    in-out property <string> room-input: "demo";
    in-out property <string> token-input: "";
    in-out property <string> server-input: "signal.aerodesk.io";
    in-out property <string> status: "未连接";
    in-out property <string> log: "";
    in-out property <bool> connecting: false;
    in-out property <int> conn-state: 0;   // 0=idle 1=connecting 2=connected 3=failed
    in-out property <[string]> recents: [];
    in-out property <[string]> favorites: [];
    in-out property <[string]> addressbook: [];
    in-out property <[DeviceGroupEntry]> device-groups: [];
    in-out property <[string]> discovered: [];
    in-out property <string> ab-alias: "";
    in-out property <string> ab-group: "";
    in-out property <int> peer-tab: 0;   // 0=最近 1=收藏 2=发现 3=地址簿 4=设备组
    // 本机身份（被控端）
    in-out property <string> device-id: "—";
    in-out property <string> device-pw: "—";
    // ---- 会话 ----
    in-out property <bool> in-session: false;
    in-out property <image> video-frame: @image-url("");
    in-out property <[string]> session-tabs: [];
    in-out property <int> active-session: 0;
    in-out property <[image]> session-frames: [];
    in-out property <string> session-status: "";
    in-out property <string> input-mode: "键鼠已释放";
    // #73 观看端音量 0..1（默认 100%）。
    in-out property <float> volume: 1.0;
    // #72 文件传输进度（-1 隐藏，0..1 显示）。
    in-out property <float> file-progress: -1;
    in-out property <string> file-label: "";
    // #72 拖放发送：外部文件悬停高亮（Rust 侧拦截 winit DroppedFile 驱动）。
    in-out property <bool> file-drop-hover: false;
    // #75 远程光标（归一化 0..1；visible 控制显示）+ 视频源尺寸（letterbox 换算）。
    in-out property <float> remote-cursor-x: 0;
    in-out property <float> remote-cursor-y: 0;
    in-out property <bool> remote-cursor-visible: false;
    // #75 是否显示远端光标叠加层（设置-显示 可开）。
    // 默认关：对齐 RustDesk(show-remote-cursor=N)/TeamViewer(Show partner's cursor)
    // 主流默认，避免叠加箭头被误认为“光标被采集进视频”。
    in-out property <bool> show-remote-cursor: false;
    in-out property <float> frame-w: 0;
    in-out property <float> frame-h: 0;
    // ---- 设置 ----
    in-out property <int> settings-tab: 0;          // 0=显示 1=网络 2=安全 3=快捷键 4=AI 远控
    // #109 AI 远控：命令白名单 + 审计（本机管理入口）。
    in-out property <[string]> cmd-allowlist: [];
    in-out property <string> cmd-allowlist-input: "";
    in-out property <string> cmd-audit: "";
    in-out property <int> quality: 1;
    in-out property <string> server-default: "signal.aerodesk.io";
    in-out property <bool> remember-token: false;
    in-out property <string> token-default: "";
    in-out property <string> settings-status: "";
    // ---- 被控端授权 ----
    in-out property <string> perm-screen: "未知";
    in-out property <string> perm-a11y: "未知";
    // 被控端设置
    in-out property <bool> inc-enabled: false;
    in-out property <bool> inc-audio: true;
    in-out property <bool> inc-mouse: true;
    // #72 文件传输总开关：关闭后禁用发文件/剪贴板/拖放，并暂停接收落盘。
    in-out property <bool> file-transfer-enabled: true;
    // #58 当前会话静音态（工具栏音频按钮高亮用，按会话同步）。
    in-out property <bool> audio-muted: false;
    in-out property <bool> inc-view-only: false;
    // 设置页密码编辑
    in-out property <string> pw-edit: "";

    callback connect();
    callback disconnect();
    callback set-tab(int);
    callback connect-recent(string);
    callback copy-device-id();
    callback copy-device-pw();
    callback refresh-device-pw();
    callback toggle-fullscreen();
    callback toggle-audio();
    // #73 观看端音量滑块（0..1）。
    callback change-volume(float);
    // #75：会话视图指针输入 → Rust 侧转发为 InputFrame（0=Move 1=Down 2=Up）。
    // 传原始鼠标坐标 + 视频区尺寸 + 远端帧尺寸；Rust 侧按 image-fit: contain
    // 扣除 letterbox 后归一化，保证主控/被控宽高比不同时坐标不错位。
    callback send-input(int, float, float, float, float, float, float);
    // #75：键盘/滚轮输入 → Rust 侧转发为 InputFrame（send-key: 0=按下 1=抬起）。
    callback send-key(int, string, bool, bool, bool, bool) -> bool;
    // #75：滚轮 → send-wheel（原始坐标 + 尺寸 + 像素增量；Rust 侧 letterbox 扣减后归一化）。
    callback send-wheel(float, float, float, float, float, float, float, float);
    callback toggle-display();
    callback toggle-quality();
    callback toggle-input();
    // #72：会话视图文件/剪贴板按钮。
    callback toggle-file-transfer();
    callback send-file();
    callback send-clipboard();
    callback cancel-file();
    callback switch-session(int);
    callback set-settings-tab(int);
    // #109 AI 远控管理：白名单增删/刷新 + 审计刷新。
    callback cmd-allowlist-add();
    callback cmd-allowlist-remove(string);
    callback cmd-allowlist-refresh();
    callback cmd-audit-refresh();
    callback set-quality(int);
    callback set-peer-tab(int);
    callback toggle-favorite(string);
    callback refresh-peers();
    callback add-addressbook();
    callback remove-addressbook(string);
    callback connect-addressbook(string);
    callback scan-lan();
    callback add-discovered(string);
    callback auto-save();
    callback refresh-perms();
    callback open-screen-perms();
    callback open-a11y-perms();



    // #75：视频区 image-fit: contain 的 letterbox 换算：把归一化光标坐标
    // 映射到实际显示区域（扣除黑边）。
    function cursor-pos(view-w: length, view-h: length, fw: float, fh: float, n: float, vertical: bool) -> length {
        let scale = min(view-w / max(fw * 1px, 1px), view-h / max(fh * 1px, 1px));
        let draw-w = fw * 1px * scale;
        let draw-h = fh * 1px * scale;
        if vertical { return (view-h - draw-h) / 2 + n * draw-h; }
        return (view-w - draw-w) / 2 + n * draw-w;
    }

    title: "AeroDesk";
    width: 1000px;
    height: 680px;

    // ================ 左侧栏：本机身份（RustDesk buildLeftPane） ================
    HorizontalLayout {
        Rectangle {
            width: 200px;
            background: #efeff2;
            VerticalLayout {
                spacing: 2px;
                padding-top: 34px;
                // Logo：靠左对齐（左边距 12），下移避开左上角红绿灯（x 9-75, y 9-23）
                Rectangle {
                    height: 56px;
                    HorizontalLayout {
                        cross-axis-alignment: center;
                        padding-left: 12px;
                        spacing: 6px;
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 7px;
                            background: #0071ff;
                            Text {
                                text: "A";
                                color: #ffffff;
                                font-size: 15px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                        VerticalLayout {
                            Text { text: "AeroDesk"; font-size: 14px; font-weight: 700; color: #212121; }
                            Text { text: "Remote Desktop"; font-size: 11px; color: #8a8a90; }
                        }
                    }
                }

                // 「你的桌面」+ 提示（对齐 buildTip：左 20 / 右 16 / 上 16 / 下 5）
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 16px;
                    Text {
                        text: "你的桌面";
                        font-size: 19px;
                        color: #212121;
                        height: 26px;
                        vertical-stretch: 0;
                    }
                }
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 16px;
                    Text {
                        text: "使用下面的 ID 和密码，可以远程访问这台设备。";
                        font-size: 14px;
                        color: #6d6d73;
                        wrap: word-wrap;
                        height: 34px;
                        vertical-stretch: 0;
                    }
                }
                Rectangle { height: 5px; }

                // ID 板（对齐 buildIDBoard：左 20 右 11，2px 蓝条 + ID 标签 + 22px 大号 ID）
                HorizontalLayout {
                    cross-axis-alignment: center;
                    padding-left: 20px;
                    padding-right: 8px;
                    IdentityRow {
                        label: "ID";
                        value: root.device-id;
                        value-size: 22px;
                        copy => { root.copy-device-id(); }
                    }
                    // 右上复制 ID（对齐 RustDesk buildPopupMenu 位置的复制入口）
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 13px;
                        background: mh.has-hover ? #ffffff : transparent;
                        MIcon { icon: "\u{e14d}"; size: 18px; color: #6d6d73; }   // content_copy
                        mh := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.copy-device-id(); }
                        }
                        Tooltip { text: @markdown("复制 ID"); }
                    }
                }
                // 密码板（对齐 buildPasswordBoard：左 20 右 16 上 13 下 13）
                HorizontalLayout {
                    cross-axis-alignment: center;
                    padding-left: 20px;
                    padding-right: 8px;
                    IdentityRow {
                        label: "一次性密码";
                        value: root.device-pw;
                        value-size: 15px;
                        copy => { root.copy-device-pw(); }
                    }
                    // 刷新/编辑（对齐 RustDesk buildPasswordBoard2 的 refresh/edit 图标）
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: rh.has-hover ? #ffffff : transparent;
                        MIcon { icon: "\u{e5d5}"; size: 18px; color: #6d6d73; }   // refresh
                        rh := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.refresh-device-pw(); }
                        }
                        Tooltip { text: @markdown("刷新一次性密码"); }
                    }
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: eh.has-hover ? #ffffff : transparent;
                        MIcon { icon: "\u{e3c9}"; size: 18px; color: #6d6d73; }   // edit
                        eh := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.set-tab(1); root.set-settings-tab(2); }
                        }
                        Tooltip { text: @markdown("修改密码"); }
                    }
                }

                // 底部导航（设置 / 被控端 入口，对齐 RustDesk 左下角齿轮）
                Rectangle { vertical-stretch: 1; min-height: 0px; }
                VerticalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    spacing: 2px;
                    NavItem { icon: "\u{e157}"; text: "连接"; selected: root.tab == 0; clicked => { root.set-tab(0); } }
                    NavItem { icon: "\u{e897}"; text: "被控端"; selected: root.tab == 2; clicked => { root.set-tab(2); } }
                    NavItem { icon: "\u{e8b8}"; text: "设置"; selected: root.tab == 1; clicked => { root.set-tab(1); } }
                }
                Rectangle { height: 10px; }
            }
        }

        // 左/右分隔线（RustDesk VerticalDivider）
        Rectangle {
            width: 1px;
            background: #dedee2;
        }

        // ================ 主区域（白底，RustDesk buildRightPane） ================
        Rectangle {
            background: #ffffff;
            // ---- 连接页 ----
            if !root.in-session && root.tab == 0: VerticalLayout {
                padding-left: 24px;
                padding-right: 28px;
                padding-top: 26px;
                spacing: 16px;

                // 「控制远程桌面」标题
                HorizontalLayout {
                    Text { text: "控制远程桌面"; font-size: 19px; color: #212121; height: 26px; vertical-stretch: 0; }
                    Rectangle { width: 6px; }
                    Rectangle {
                        width: 18px;
                        height: 26px;
                        MIcon { icon: "\u{e8fd}"; size: 16px; color: #9a9aa0; }   // help_outline
                    }
                }

                // 连接区：左 = 远端 ID 卡片，右 = 被控端授权（利用右侧空白）
                HorizontalLayout {
                    width: 100%;
                    cross-axis-alignment: stretch;
                    spacing: 16px;
                    // 远端 ID 卡片（对齐 RustDesk：白底、圆角 13、灰描边、右侧蓝色「连接」）
                    Rectangle {
                        width: 400px;
                        vertical-stretch: 0;
                        border-radius: 13px;
                        border-width: 1px;
                        border-color: #efeff2;
                        background: #ffffff;
                        VerticalLayout {
                            padding-left: 24px;
                            padding-right: 24px;
                            padding-top: 24px;
                            padding-bottom: 22px;
                            spacing: 14px;
                            Text { text: "远端 ID"; font-size: 14px; color: #7d7d84; height: 18px; vertical-stretch: 0; }
                            RdInput {
                                text <=> root.room-input;
                                placeholder: "输入对端 ID";
                                font-size: 22px;
                            }
                            HorizontalLayout {
                                cross-axis-alignment: center;
                                spacing: 4px;
                                Text { text: "访问凭证 / JWT（可选）"; font-size: 14px; color: #7d7d84; height: 18px; vertical-stretch: 0; }
                                Rectangle {
                                    width: 16px;
                                    height: 18px;
                                    MIcon { icon: "\u{e8fd}"; size: 13px; color: #9a9aa0; }   // help_outline
                                    Tooltip {
                                        Rectangle {
                                            background: #3c4043;
                                            border-radius: 4px;
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            padding-top: 4px;
                                            padding-bottom: 4px;
                                            Text { text: "服务器管理员分发的连接授权凭证（JWT/静态 token）；未配置认证时留空"; font-size: 12px; color: #ffffff; }
                                        }
                                    }
                                }
                            }
                            RdInput {
                                text <=> root.token-input;
                                placeholder: "留空或填管理员给的凭证";
                                font-size: 15px;
                            }
                            Text { text: "信令服务器"; font-size: 14px; color: #7d7d84; height: 18px; vertical-stretch: 0; }
                            RdInput {
                                text <=> root.server-input;
                                placeholder: "signal.aerodesk.io 或 127.0.0.1:3003";
                                font-size: 14px;
                                edited => { root.server-default = root.server-input; root.auto-save(); }
                            }
                            HorizontalLayout {
                                cross-axis-alignment: center;
                                spacing: 8px;
                                Rectangle { width: 0px; }
                                RdButton {
                                    text: connecting ? "连接中…" : (root.conn-state == 3 ? "重连" : "连接");
                                    enabled: !connecting && !root.in-session;
                                    primary: true;
                                    width: 120px;
                                    clicked => { root.connect(); }
                                }
                                RdButton {
                                    text: "断开";
                                    width: 76px;
                                    enabled: connecting || root.in-session;
                                    clicked => { root.disconnect(); }
                                }
                                Text {
                                    text: root.status;
                                    color: root.conn-state == 2 ? #34a853 : (root.conn-state == 3 ? #d93025 : #9a9aa0);
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    vertical-stretch: 0;
                                }
                            }
                        }
                    }

                    // 被控端授权卡片（与「被控端」页共用 PermissionCard 组件）
                    PermissionCard {
                        width: max(0px, parent.width - 416px);
                        perm-screen: root.perm-screen;
                        perm-a11y: root.perm-a11y;
                        refresh => { root.refresh-perms(); }
                        open-screen => { root.open-screen-perms(); }
                        open-a11y => { root.open-a11y-perms(); }
                    }
                }

                // 分隔线
                Rectangle { height: 1px; background: #efeff2; }

                // Peer 标签栏（对齐 RustDesk PeerTabPage：最近/收藏/发现/地址簿/设备组）
                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 4px;
                    height: 36px;
                    PeerTab { icon: "\u{e192}"; tooltip: "最近会话"; selected: root.peer-tab == 0; clicked => { root.set-peer-tab(0); } }
                    PeerTab { icon: "\u{e838}"; tooltip: "收藏"; selected: root.peer-tab == 1; clicked => { root.set-peer-tab(1); } }
                    PeerTab { icon: "\u{e87a}"; tooltip: "发现"; selected: root.peer-tab == 2; clicked => { root.set-peer-tab(2); } }
                    PeerTab { icon: "\u{e0ba}"; tooltip: "地址簿"; selected: root.peer-tab == 3; clicked => { root.set-peer-tab(3); } }
                    PeerTab { icon: "\u{e7ef}"; tooltip: "设备组"; selected: root.peer-tab == 4; clicked => { root.set-peer-tab(4); } }
                    Rectangle { width: 0px; horizontal-stretch: 1; }
                    IconBtn { icon: "\u{e5d5}"; tooltip: "刷新"; clicked => { root.refresh-peers(); } }
                }
                // 列表标题（跟随标签）
                Text {
                    text: root.peer-tab == 0 ? "最近会话" : (root.peer-tab == 1 ? "我的收藏" : (root.peer-tab == 2 ? "发现（局域网）" : (root.peer-tab == 3 ? "地址簿" : "设备组")));
                    font-size: 14px; color: #7d7d84; height: 18px; vertical-stretch: 0;
                }
                if root.peer-tab == 0: ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 2px;
                        for item in root.recents: Rectangle {
                            height: 46px;
                            border-radius: 8px;
                            background: rec.has-hover ? #f2f2f5 : transparent;
                            rec := TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                clicked => { root.connect-recent(item); }
                            }
                            HorizontalLayout {
                                cross-axis-alignment: center;
                                padding-left: 10px;
                                spacing: 12px;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 16px;
                                    background: #0071ff;
                                    Text {
                                        text: "A";
                                        color: #ffffff;
                                        font-size: 14px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }
                                }
                                Text {
                                    text: item;
                                    font-size: 14px;
                                    color: #212121;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Rectangle { width: 0px; horizontal-stretch: 1; }
                                IconBtn { icon: "\u{e83a}"; tooltip: "收藏"; clicked => { root.toggle-favorite(item); } }
                            }
                        }
                    }
                }
                if root.peer-tab == 1: ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 2px;
                        for item in root.favorites: Rectangle {
                            height: 46px;
                            border-radius: 8px;
                            background: fav.has-hover ? #f2f2f5 : transparent;
                            fav := TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                clicked => { root.connect-recent(item); }
                            }
                            HorizontalLayout {
                                cross-axis-alignment: center;
                                padding-left: 10px;
                                spacing: 12px;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 16px;
                                    background: #f5a623;
                                    Text {
                                        text: "★";
                                        color: #ffffff;
                                        font-size: 14px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }
                                }
                                Text {
                                    text: item;
                                    font-size: 14px;
                                    color: #212121;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Rectangle { width: 0px; horizontal-stretch: 1; }
                                IconBtn { icon: "\u{e838}"; tooltip: "取消收藏"; clicked => { root.toggle-favorite(item); } }
                            }
                        }
                    }
                }
                // ---- 发现（局域网扫描）----
                if root.peer-tab == 2: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        cross-axis-alignment: center;
                        spacing: 10px;
                        RdButton { text: "扫描局域网"; primary: true; width: 110px; clicked => { root.scan-lan(); } }
                        Text { text: "扫描本网段信令端口（3003）"; font-size: 13px; color: #7d7d84; height: 18px; vertical-stretch: 0; }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            for item in root.discovered: Rectangle {
                                height: 42px;
                                border-radius: 8px;
                                background: dsc.has-hover ? #f2f2f5 : transparent;
                                dsc := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: pointer;
                                    clicked => { root.connect-addressbook(item); }
                                }
                                HorizontalLayout {
                                    cross-axis-alignment: center;
                                    padding-left: 10px;
                                    spacing: 10px;
                                    Rectangle { width: 26px; height: 26px; border-radius: 13px; background: #34a853; Text { text: "·"; color: #fff; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; } }
                                    Text { text: item; font-size: 13px; color: #212121; vertical-alignment: center; overflow: elide; }
                                    Rectangle { width: 0px; horizontal-stretch: 1; }
                                    IconBtn { icon: "\u{e865}"; tooltip: "添加到地址簿"; clicked => { root.add-discovered(item); } }
                                }
                            }
                        }
                    }
                }
                // ---- 地址簿（本地持久化）----
                if root.peer-tab == 3: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        cross-axis-alignment: center;
                        spacing: 8px;
                        Text { text: "别名"; font-size: 13px; color: #7d7d84; height: 18px; vertical-stretch: 0; }
                        Rectangle { width: 110px; height: 34px; border-radius: 8px; background: #efeff2; ti := TextInput { x: 10px; y: 0px; width: parent.width - 20px; height: 100%; text <=> root.ab-alias; color: #212121; font-size: 13px; vertical-alignment: center; single-line: true; } }
                        Text { text: "分组"; font-size: 13px; color: #7d7d84; height: 18px; vertical-stretch: 0; }
                        Rectangle { width: 90px; height: 34px; border-radius: 8px; background: #efeff2; tg := TextInput { x: 10px; y: 0px; width: parent.width - 20px; height: 100%; text <=> root.ab-group; color: #212121; font-size: 13px; vertical-alignment: center; single-line: true; } }
                        RdButton { text: "添加"; width: 64px; clicked => { root.add-addressbook(); } }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            for item in root.addressbook: Rectangle {
                                height: 46px;
                                border-radius: 8px;
                                background: ab.has-hover ? #f2f2f5 : transparent;
                                ab := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: pointer;
                                    clicked => { root.connect-addressbook(item); }
                                }
                                HorizontalLayout {
                                    cross-axis-alignment: center;
                                    padding-left: 10px;
                                    spacing: 12px;
                                    Rectangle { width: 32px; height: 32px; border-radius: 16px; background: #e0742e; Text { text: "✉"; color: #fff; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; } }
                                    Text { text: item; font-size: 13px; color: #212121; vertical-alignment: center; overflow: elide; }
                                    Rectangle { width: 0px; horizontal-stretch: 1; }
                                    IconBtn { icon: "\u{e872}"; danger: true; tooltip: "删除"; clicked => { root.remove-addressbook(item); } }
                                }
                            }
                        }
                    }
                }
                // ---- 设备组（按地址簿“分组”字段聚合展示：组标题 + 组内设备）----
                if root.peer-tab == 4: ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 2px;
                        for item in root.device-groups: Rectangle {
                            visible: item.is-header;
                            height: 30px;
                            padding-left: 10px;
                            Text { text: item.text; font-size: 13px; font-weight: 600; color: #7d7d84; vertical-alignment: center; }
                        }
                        for item in root.device-groups: Rectangle {
                            visible: !item.is-header;
                            height: 42px;
                            border-radius: 8px;
                            background: dgrp.has-hover ? #f2f2f5 : transparent;
                            dgrp := TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                clicked => { root.connect-addressbook(item.entry); }
                            }
                            HorizontalLayout {
                                cross-axis-alignment: center;
                                padding-left: 10px;
                                spacing: 10px;
                                Rectangle { width: 30px; height: 30px; border-radius: 15px; background: #6d3bdc; Text { text: "☰"; color: #fff; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; } }
                                Text { text: item.text; font-size: 13px; color: #212121; vertical-alignment: center; overflow: elide; }
                                Rectangle { width: 0px; horizontal-stretch: 1; }
                                IconBtn { icon: "\u{e872}"; danger: true; tooltip: "删除"; clicked => { root.remove-addressbook(item.entry); } }
                            }
                        }
                    }
                }

                // 底部状态栏（对齐 RustDesk OnlineStatusWidget）
                HorizontalLayout {
                    padding-top: 6px;
                    padding-bottom: 8px;
                    spacing: 8px;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.conn-state == 2 ? #34a853 : (root.conn-state == 3 ? #e04f5f : (root.connecting ? #f5a623 : #efeff2));
                    }
                    Text {
                        text: root.status == "" ? "就绪" : root.status;
                        font-size: 14px;
                        color: #616161;
                        vertical-alignment: center;
                        vertical-stretch: 0;
                    }
                    Rectangle { width: 0px; }
                    if root.log != "": Text {
                        text: root.log;
                        font-size: 12px;
                        color: #9a9aa0;
                        vertical-alignment: center;
                        overflow: elide;
                        vertical-stretch: 0;
                    }
                }
            }

            // ---- 设置页 ----
            if !root.in-session && root.tab == 1: VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 24px;
                spacing: 16px;
                Text { text: "设置"; font-size: 19px; color: #212121; height: 26px; vertical-stretch: 0; }
                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: 8px;
                    RdButton { text: "显示"; width: 72px; checked: root.settings-tab == 0; clicked => { root.set-settings-tab(0); } }
                    RdButton { text: "网络"; width: 72px; checked: root.settings-tab == 1; clicked => { root.set-settings-tab(1); } }
                    RdButton { text: "安全"; width: 72px; checked: root.settings-tab == 2; clicked => { root.set-settings-tab(2); } }
                    RdButton { text: "快捷键"; width: 84px; checked: root.settings-tab == 3; clicked => { root.set-settings-tab(3); } }
                    RdButton { text: "AI 远控"; width: 84px; checked: root.settings-tab == 4; clicked => { root.set-settings-tab(4); } }
                }
                Rectangle { height: 1px; background: #efeff2; }

                if root.settings-tab == 0: VerticalLayout {
                    spacing: 12px;
                    Text { text: "显示质量"; font-size: 15px; color: #212121; height: 20px; vertical-stretch: 0; }
                    HorizontalLayout {
                        cross-axis-alignment: center;
                        spacing: 8px;
                        RdButton { text: "清晰（8Mbps）"; width: 120px; checked: root.quality == 0; clicked => { root.set-quality(0); root.auto-save(); } }
                        RdButton { text: "平衡（4Mbps）"; width: 120px; checked: root.quality == 1; clicked => { root.set-quality(1); root.auto-save(); } }
                        RdButton { text: "流畅（1.5Mbps）"; width: 120px; checked: root.quality == 2; clicked => { root.set-quality(2); root.auto-save(); } }
                    }
                    Text { text: "质量 → 目标码率：清晰 8Mbps / 平衡 4Mbps / 流畅 1.5Mbps（对接 SFU 选层）"; font-size: 14px; color: #7d7d84; height: 18px; vertical-stretch: 0; }
                    Switch { text: "显示远端光标（蓝色叠加层，表示被控端鼠标位置）"; checked <=> root.show-remote-cursor; toggled => { root.auto-save(); } }
                }
                if root.settings-tab == 1: VerticalLayout {
                    spacing: 12px;
                    Text { text: "默认信令服务器"; font-size: 15px; color: #212121; height: 20px; vertical-stretch: 0; }
                    RdInput { text <=> root.server-default; placeholder: "signal.aerodesk.io 或 127.0.0.1:3003"; font-size: 14px; edited => { root.server-input = root.server-default; root.auto-save(); } }
                    Text { text: "中继偏好：自动（直连失败走 TURN）"; font-size: 14px; color: #7d7d84; height: 18px; vertical-stretch: 0; }
                }
                if root.settings-tab == 2: VerticalLayout {
                    spacing: 12px;
                    CheckBox { text: "记住访问凭证 / JWT"; checked <=> root.remember-token; toggled => { root.auto-save(); } }
                    Text { text: "默认访问凭证 / JWT（可选）"; font-size: 15px; color: #212121; height: 20px; vertical-stretch: 0; }
                    RdInput { text <=> root.token-default; placeholder: "默认访问凭证 / JWT（可选）"; font-size: 14px; edited => { root.auto-save(); } }
                    Rectangle { height: 1px; background: #efeff2; }
                    Text { text: "本机接入密码（被控端一次性密码）"; font-size: 15px; color: #212121; height: 20px; vertical-stretch: 0; }
                    RdInput { text <=> root.pw-edit; placeholder: "留空则不修改"; font-size: 14px; edited => { root.auto-save(); } }
                    Text { text: "修改后立即生效并同步左栏；点左栏刷新图标可随机生成"; font-size: 13px; color: #7d7d84; height: 18px; vertical-stretch: 0; }
                }
                if root.settings-tab == 3: VerticalLayout {
                    spacing: 12px;
                    Text { text: "全屏：F11（待绑定）"; font-size: 14px; color: #4d4d52; height: 18px; vertical-stretch: 0; }
                    Text { text: "输入捕获/释放：Esc（待绑定）"; font-size: 14px; color: #4d4d52; height: 18px; vertical-stretch: 0; }
                    Text { text: "断开：Ctrl+Alt+D（待绑定）"; font-size: 14px; color: #4d4d52; height: 18px; vertical-stretch: 0; }
                }
                if root.settings-tab == 4: VerticalLayout {
                    spacing: 10px;
                    Text { text: "AI 远控权限（#109）"; font-size: 15px; font-weight: 600; color: #212121; height: 20px; vertical-stretch: 0; }
                    Text { text: "命令白名单：每行一个前缀；危险命令（rm -rf/dd/shutdown/交互式等）默认拦截，前缀命中可放行。文件在 ~/AeroDesk/cmd-allowlist.txt。"; font-size: 13px; color: #7d7d84; height: 32px; vertical-stretch: 0; }
                    HorizontalLayout {
                        cross-axis-alignment: center;
                        spacing: 8px;
                        RdInput { text <=> root.cmd-allowlist-input; placeholder: "命令前缀，如 /tmp/safe"; font-size: 14px; edited => { root.cmd-allowlist-add(); } }
                        RdButton { text: "添加"; width: 72px; clicked => { root.cmd-allowlist-add(); } }
                        RdButton { text: "刷新"; width: 72px; clicked => { root.cmd-allowlist-refresh(); } }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            if root.cmd-allowlist.length == 0: Text { text: "（空）"; font-size: 13px; color: #9a9aa0; height: 24px; }
                            for item in root.cmd-allowlist: Rectangle {
                                height: 34px;
                                border-radius: 6px;
                                background: #f7f7f9;
                                HorizontalLayout {
                                    cross-axis-alignment: center;
                                    padding-left: 10px;
                                    spacing: 8px;
                                    Text { text: item; font-size: 13px; color: #212121; vertical-alignment: center; overflow: elide; }
                                    Rectangle { width: 0px; horizontal-stretch: 1; }
                                    IconBtn { icon: "\u{e872}"; danger: true; tooltip: "移除"; clicked => { root.cmd-allowlist-remove(item); } }
                                }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: #efeff2; }
                    Text { text: "命令审计（最近 30 条，~/AeroDesk/cmd-audit.jsonl）"; font-size: 14px; color: #4d4d52; height: 18px; vertical-stretch: 0; }
                    HorizontalLayout {
                        RdButton { text: "刷新审计"; width: 96px; clicked => { root.cmd-audit-refresh(); } }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        Text { text: root.cmd-audit; font-size: 11px; color: #4d4d52; }
                    }
                }
                Text { text: "所有设置修改后自动保存"; font-size: 13px; color: #9a9aa0; height: 18px; vertical-stretch: 0; }
            }

            // ---- 被控端页 ----
            if !root.in-session && root.tab == 2: VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 24px;
                spacing: 16px;
                Text { text: "被控端"; font-size: 19px; color: #212121; height: 26px; vertical-stretch: 0; }
                Text { text: "本机作为被控端时的接入设置与 macOS 权限："; font-size: 14px; color: #6d6d73; height: 18px; vertical-stretch: 0; }

                // 被控端设置卡片
                Rectangle {
                    width: 420px;
                    vertical-stretch: 0;
                    border-radius: 13px;
                    border-width: 1px;
                    border-color: #efeff2;
                    background: #ffffff;
                    VerticalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        padding-top: 18px;
                        padding-bottom: 18px;
                        spacing: 10px;
                        Text { text: "接入设置"; font-size: 15px; font-weight: 600; color: #212121; height: 20px; vertical-stretch: 0; }
                        Switch { text: "开启被控（允许被远程接入）"; checked <=> root.inc-enabled; toggled => { root.auto-save(); } }
                        Switch { text: "允许声音（被控端采集系统音频）"; enabled: root.inc-enabled; checked <=> root.inc-audio; toggled => { root.auto-save(); } }
                        Switch { text: "仅观看（只读，禁止鼠标/键盘控制）"; enabled: root.inc-enabled; checked <=> root.inc-view-only; toggled => { root.auto-save(); } }
                        Text { text: "设置修改后自动保存；开关即时反映状态"; font-size: 13px; color: #7d7d84; height: 18px; vertical-stretch: 0; }
                    }
                }

                // 权限卡片（与主页共用 PermissionCard 组件，视觉一致）
                Rectangle {
                    width: 420px;
                    vertical-stretch: 0;
                    PermissionCard {
                        perm-screen: root.perm-screen;
                        perm-a11y: root.perm-a11y;
                        refresh => { root.refresh-perms(); }
                        open-screen => { root.open-screen-perms(); }
                        open-a11y => { root.open-a11y-perms(); }
                    }
                }
            }

            // ---- 会话视图（对齐 RustDesk remote_page：大视频区 + 悬浮工具栏） ----
            if root.in-session: VerticalLayout {
                spacing: 0px;
                vertical-stretch: 1;
                // 会话标签行（仅有多会话时显示）
                // 标签数量与 Rust 侧 MAX_SESSIONS=4 耦合（见 main.rs const MAX_SESSIONS）。
                if root.session-tabs.length > 0: HorizontalLayout {
                    spacing: 0px;
                    if root.session-tabs.length > 0: SessionTab { text: root.session-tabs[0]; selected: root.active-session == 0; clicked => { root.switch-session(0); } }
                    if root.session-tabs.length > 1: SessionTab { text: root.session-tabs[1]; selected: root.active-session == 1; clicked => { root.switch-session(1); } }
                    if root.session-tabs.length > 2: SessionTab { text: root.session-tabs[2]; selected: root.active-session == 2; clicked => { root.switch-session(2); } }
                    if root.session-tabs.length > 3: SessionTab { text: root.session-tabs[3]; selected: root.active-session == 3; clicked => { root.switch-session(3); } }
                }
                // 视频区（占满剩余空间，黑底）；TouchArea 捕获指针 → 输入通道（#75）
                Rectangle {
                    background: #000000;
                    vertical-stretch: 1;
                    // #75：键盘焦点——进入会话/点击视频区即聚焦，键码映射后走 send-key。
                    fs := FocusScope {
                        focus-on-click: true;
                        init => { fs.focus(); }
                        key-pressed(event) => {
                            // 键码映射在 Rust 侧（keymap.rs），返回是否已处理。
                            if root.send-key(
                                0,
                                event.text,
                                event.modifiers.control,
                                event.modifiers.shift,
                                event.modifiers.alt,
                                event.modifiers.meta
                            ) { accept } else { reject }
                        }
                        key-released(event) => {
                            if root.send-key(
                                1,
                                event.text,
                                event.modifiers.control,
                                event.modifiers.shift,
                                event.modifiers.alt,
                                event.modifiers.meta
                            ) { accept } else { reject }
                        }
                    }
                    TouchArea {
                        width: 100%;
                        height: 100%;
                        enabled: root.in-session && root.session-frames[root.active-session].width > 0;
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down { fs.focus(); }
                            root.send-input(
                                event.kind == PointerEventKind.down ? 1 : (event.kind == PointerEventKind.up ? 2 : 0),
                                self.mouse-x / 1px,
                                self.mouse-y / 1px,
                                self.width / 1px,
                                self.height / 1px,
                                root.frame-w,
                                root.frame-h
                            );
                        }
                        // #75：滚轮 → send-wheel（原始坐标 + 尺寸 + 像素增量）。
                        scroll-event(event) => {
                            root.send-wheel(
                                self.mouse-x / 1px,
                                self.mouse-y / 1px,
                                self.width / 1px,
                                self.height / 1px,
                                root.frame-w,
                                root.frame-h,
                                event.delta-x / 1px,
                                event.delta-y / 1px
                            );
                            accept
                        }
                    }
                    Image {
                        source: root.session-frames[root.active-session];
                        width: 100%;
                        height: 100%;
                        image-fit: contain;
                    }
                    // #75 远程光标叠加（蓝色半透明箭头，随被控端光标移动）。
                    // 样式刻意区别于被控端真实鼠标（黑箭头），避免误认为光标被采集进视频。
                    if root.show-remote-cursor && root.remote-cursor-visible && root.frame-w > 0: Path {
                        x: root.cursor-pos(parent.width, parent.height, root.frame-w, root.frame-h, root.remote-cursor-x, false);
                        y: root.cursor-pos(parent.width, parent.height, root.frame-w, root.frame-h, root.remote-cursor-y, true);
                        width: 16px;
                        height: 20px;
                        commands: "M 0 0 L 0 20 L 5 15 L 8 19 L 10 17 L 7 13 L 12 13 Z";
                        fill: #0a84ffb3;
                        stroke: #ffffff;
                        stroke-width: 1.5px;
                    }
                    // #72 文件传输进度条（发送/接收中显示）。
                    if root.file-progress >= 0: Rectangle {
                        x: 12px;
                        y: parent.height - 34px;
                        width: 280px;
                        height: 24px;
                        border-radius: 4px;
                        background: #ffffffcc;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            ProgressIndicator {
                                width: 180px;
                                height: 8px;
                                progress: root.file-progress;
                            }
                            Text {
                                text: root.file-label;
                                font-size: 11px;
                                color: #212121;
                                vertical-alignment: center;
                            }
                            IconBtn { icon: "\u{e5cd}"; danger: true; width: 22px; height: 20px; tooltip: "取消发送"; clicked => { root.cancel-file(); } }
                        }
                    }
                    if root.session-frames[root.active-session].width == 0: Text {
                        text: "等待媒体流…（真实解码已接入 macOS）";
                        color: #888888;
                        font-size: 14px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                    // #72 拖放发送：外部文件悬停时高亮提示（松开放入即发送）。
                    if root.file-drop-hover: Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        background: #34a85333;
                        border-width: 2px;
                        border-color: #34a853;
                        border-radius: 6px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text {
                                text: "松开发送文件";
                                color: #34a853;
                                font-size: 22px;
                                font-weight: 700;
                            }
                            Text {
                                text: "拖拽任意文件到会话窗口";
                                color: #ffffff;
                                font-size: 13px;
                            }
                        }
                    }
                    // 悬浮工具栏（对齐 RustDesk remote_toolbar：白底圆角、图标按钮）
                    Rectangle {
                        x: 12px;
                        y: 12px;
                        width: 470px;
                        height: 44px;
                        border-radius: 6px;
                        background: #ffffff;
                        border-width: 1px;
                        border-color: #d9d9de;
                        HorizontalLayout {
                            cross-axis-alignment: center;
                            padding-left: 4px;
                            padding-right: 4px;
                            spacing: 2px;
                            IconBtn { icon: "\u{e5d0}"; tooltip: "全屏"; clicked => { root.toggle-fullscreen(); } }
                            IconBtn { icon: "\u{e050}"; active: root.audio-muted; danger: root.audio-muted; tooltip: root.audio-muted ? "音频已静音（本会话）" : "音频"; clicked => { root.toggle-audio(); } }
                            Slider {
                                width: 80px;
                                minimum: 0;
                                maximum: 1;
                                value: root.volume;
                                changed(value) => {
                                    root.volume = value;
                                    root.change-volume(value);
                                }
                            }
                            IconBtn { icon: "\u{e30c}"; tooltip: "显示器"; clicked => { root.toggle-display(); } }
                            IconBtn { icon: "\u{e429}"; tooltip: "画质"; clicked => { root.toggle-quality(); } }
                            IconBtn { icon: "\u{e312}"; tooltip: "输入"; clicked => { root.toggle-input(); } }
                            IconBtn { icon: "\u{e2c8}"; active: root.file-transfer-enabled; danger: !root.file-transfer-enabled; tooltip: root.file-transfer-enabled ? "文件传输：开" : "文件传输：关（点击开启）"; clicked => { root.toggle-file-transfer(); } }
                            IconBtn { icon: "\u{e14f}"; enabled: root.file-transfer-enabled; tooltip: "发文件"; clicked => { root.send-file(); } }
                            IconBtn { icon: "\u{e2c7}"; enabled: root.file-transfer-enabled; tooltip: "剪贴板"; clicked => { root.send-clipboard(); } }
                            Rectangle { width: 1px; height: 22px; background: #dedee2; }
                            IconBtn { icon: "\u{e5cd}"; danger: true; tooltip: "断开"; clicked => { root.disconnect(); } }
                            Rectangle { width: 6px; }
                            Text {
                                text: root.session-status;
                                color: #34a853;
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                // 底部状态行
                Rectangle {
                    height: 28px;
                    background: #ffffff;
                    HorizontalLayout {
                        padding-left: 14px;
                        spacing: 8px;
                        Text {
                            text: "输入模式：" + root.input-mode;
                            color: #7d7d84;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
