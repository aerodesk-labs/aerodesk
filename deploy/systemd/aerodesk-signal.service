# AeroDesk 信令服务 systemd 单元模板（P3 SIP 单栈）
# 安装：sudo cp deploy/systemd/aerodesk-signal.service /etc/systemd/system/
[Unit]
Description=AeroDesk Signaling (SIP single-stack: REGISTER/INVITE + ops HTTP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aerodesk
Group=aerodesk
StateDirectory=aerodesk
ExecStart=/opt/aerodesk/aerodesk-signal
Restart=on-failure
RestartSec=2
# HTTP 运维面（/healthz /devices /metrics/prometheus /admin/temp-password）
Environment=SIGNAL_OPS_PORT=3001
# P3 SIP 三传输默认全开（SIP/UDP 5060、SIP/TLS 5061、SIP/WSS 3061）；
# 如需显式固定或关闭（off/disabled/none）：
# Environment=SIP_UDP_PORT=5060
# Environment=SIP_TLS_PORT=5061
# Environment=SIP_WSS_PORT=3061
# 认证（AUTH_TOKENS 兼作 SIP Digest 回退口令与 /admin 鉴权回退）
Environment=AUTH_TOKENS=CHANGE_ME_AUTH_TOKEN
# SFU 内部接口（会议 INVITE 桥接）
Environment=SFU_URL=http://127.0.0.1:3002
Environment=SFU_TOKEN=CHANGE_ME_SFU_INTERNAL_TOKEN
# 多 PoP（#146/#154；跨 PoP 房间经 302+Contact 引导）
# Environment=POP_ID=pop-b
# Environment=POP_REGISTRY_FILE=/var/lib/aerodesk/pop-registry.json
# Environment=POP_REGISTRY_TTL_SECS=3600
# Environment=POP_SIP_URLS=pop-a=pop-a.example.com:5060
# 证书（可选；缺省用仓库内嵌开发证书，生产必须配）
# Environment=CERT_FILE=/etc/aerodesk/tls/cer.pem
# Environment=KEY_FILE=/etc/aerodesk/tls/key.pem

[Install]
WantedBy=multi-user.target
